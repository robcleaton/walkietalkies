# Create an internal integration at https://www.notion.so/my-integrations,
# then share the "WalkieTalkies Stops" database with it (··· menu on the
# database → Connections → your integration). Copy its secret here.
NOTION_TOKEN=

# The database ID from its Notion URL:
# https://www.notion.so/workspace/<DATABASE_ID>?v=...
NOTION_DATABASE_ID=

# ElevenLabs narration (scripts/generate-audio.js). API key from
# https://elevenlabs.io/app/settings/api-keys; the voice ID is on each
# voice's page in the ElevenLabs Voice Library ("ID" / copy button).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional — defaults to eleven_multilingual_v2.
ELEVENLABS_MODEL_ID=
